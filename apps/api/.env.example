# ─── APPLICATION ───
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# ─── DATABASE ───
DATABASE_URL=postgresql://bookmyturf:bookmyturf_dev@localhost:5432/bookmyturf?schema=public

# ─── REDIS ───
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── JWT ───
JWT_ACCESS_SECRET=your-access-secret-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── GOOGLE OAUTH ───
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/v1/auth/google/callback

# ─── OTP ───
OTP_PROVIDER=dev
OTP_API_KEY=
OTP_SENDER_ID=BKTURF
OTP_TEMPLATE_ID=
OTP_EXPIRY_MINUTES=10

# ─── RAZORPAY ───
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── AWS S3 ───
AWS_REGION=ap-south-1
AWS_S3_BUCKET=bookmyturf-assets
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_CLOUDFRONT_URL=

# ─── WHATSAPP ───
WHATSAPP_PROVIDER=interakt
WHATSAPP_API_KEY=
WHATSAPP_API_URL=https://api.interakt.ai/v1

# ─── EMAIL ───
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=BookMyTurf <noreply@bookmyturf.in>

# ─── SENTRY ───
SENTRY_DSN=

# ─── RATE LIMITING ───
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ─── BOOKING ───
BOOKING_HOLD_MINUTES=10
TRIAL_DAYS=14
