# ─────────────────────────────────────────────────────────────────────────────
# E2E TEST ENVIRONMENT (copy to .env.test)
#
# Used by `pnpm test:e2e` (loaded via `dotenv -e .env.test`). Points at a DEDICATED
# test database so e2e runs never touch dev/working data. Uses REAL Postgres + REAL
# Redis; external I/O (S3 uploads, OTP SMS-send, Google token verification) is mocked
# in the harness, so no real cloud credentials are needed here.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=test

# ─── DATABASE (dedicated test DB — NOT the dev DB) ───
DATABASE_URL=postgresql://bookmyturf:bookmyturf_dev@localhost:5432/bookmyturf_test?schema=public

# ─── REDIS (real, shared with dev instance; keys are test-scoped/cleaned) ───
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── JWT (test-only secrets; tests sign tokens with these) ───
JWT_ACCESS_SECRET=dev-access-secret-change-in-production-32
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production-32
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── OTP (dev provider → fixed code 123456; SMS-send is mocked in the harness) ───
OTP_PROVIDER=dev
OTP_EXPIRY_MINUTES=10

# ─── UPLOADS / GOOGLE (mocked in the harness — no real creds needed) ───
UPLOAD_PROVIDER=dev
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── RATE LIMITING ───
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ─── BOOKING ───
BOOKING_HOLD_MINUTES=10
TRIAL_DAYS=14
